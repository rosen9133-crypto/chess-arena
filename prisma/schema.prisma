// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GameStatus {
  IN_PROGRESS
  FINISHED
  ABORTED
}

enum GameResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
}

enum GameEndReason {
  CHECKMATE
  DRAW
  RESIGNATION
  TIMEOUT
}

enum GameDrawOfferBy {
  WHITE
  BLACK
}

enum GameRematchOfferBy {
  WHITE
  BLACK
}

enum GameTimeControl {
  BULLET
  BLITZ
  RAPID
}

model User {
  id       String @id @default(cuid())
  username String @unique
  email    String @unique
  password String

  rating Int @default(1500)

  bulletRating          Float @default(1500)
  bulletRatingDeviation Float @default(350)
  bulletVolatility      Float @default(0.06)

  blitzRating          Float @default(1500)
  blitzRatingDeviation Float @default(350)
  blitzVolatility      Float @default(0.06)

  rapidRating          Float @default(1500)
  rapidRatingDeviation Float @default(350)
  rapidVolatility      Float @default(0.06)

  wins   Int @default(0)
  losses Int @default(0)
  draws  Int @default(0)

  gamesAsWhite Game[] @relation("WhitePlayer")
  gamesAsBlack Game[] @relation("BlackPlayer")

  matchmakingQueue MatchmakingQueue?

  createdAt DateTime @default(now())
}

model Game {
  id String @id @default(cuid())

  whitePlayerId String
  blackPlayerId String

  whitePlayer User @relation("WhitePlayer", fields: [whitePlayerId], references: [id])
  blackPlayer User @relation("BlackPlayer", fields: [blackPlayerId], references: [id])

  status    GameStatus     @default(IN_PROGRESS)
  result    GameResult?
  endReason GameEndReason?

  drawOfferBy   GameDrawOfferBy?
  drawOfferedAt DateTime?

  rematchOfferBy   GameRematchOfferBy?
  rematchOfferedAt DateTime?
  rematchGameId    String?

  timeControl GameTimeControl
  rated       Boolean @default(true)

  initialTimeSeconds Int
  incrementSeconds   Int @default(0)

  whiteTimeMs    Int @default(0)
  blackTimeMs    Int @default(0)
  clockStartedAt DateTime?

  fen String @default("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
  pgn String @default("")

  startedAt DateTime @default(now())
  endedAt   DateTime?

  @@index([whitePlayerId])
  @@index([blackPlayerId])
  @@index([status])
  @@index([startedAt])
}

model MatchmakingQueue {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  timeControl        GameTimeControl
  initialTimeSeconds Int
  incrementSeconds   Int @default(0)
  rated              Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([timeControl, initialTimeSeconds, incrementSeconds, rated])
  @@index([createdAt])
}